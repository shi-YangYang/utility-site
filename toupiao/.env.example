# 本地配置模板。
#
# 使用方式：
#   cp .env.example .env
# 然后按注释修改。.env 已被 git 忽略，绝不能提交。
#
# 启动只需要 ADMIN_PASSWORD 与 SESSION_SECRET。
# 钉钉登录推荐在管理后台 /admin 的「钉钉登录」面板填写（保存后立即生效，无需重启）；
# 下面的 DINGTALK_* / PUBLIC_BASE_URL 只是首次部署的可选引导值，后台保存的值优先。

# 运行
PORT=3001
NODE_ENV=development

# Docker 宿主映射端口（仅 docker compose 使用；默认 3001）
# HOST_PORT=3001
# 生产建议只绑定 Docker 网关，避免 3001 暴露公网（Caddy 通过 host.docker.internal 访问）
# BIND_HOST=172.17.0.1

# 后台管理口令，至少 8 位；不要使用本示例值
ADMIN_PASSWORD=change-me-now

# 会话签名密钥，至少 32 位随机串
# 生成示例：openssl rand -hex 32
# 注意：已保存的 AppSecret 由 SESSION_SECRET 派生密钥加密；更换后需要在后台重新填写 AppSecret。
SESSION_SECRET=replace-with-at-least-32-random-characters

# 站点对外地址（可选引导值）；后台「钉钉登录」面板保存的值优先。
# 例：https://vote.example.com
PUBLIC_BASE_URL=

# 钉钉企业内部应用凭据（可选引导值；推荐在后台填写）
DINGTALK_APP_KEY=
DINGTALK_APP_SECRET=
# 可选：企业 corpId，填写后登录限定到该企业
DINGTALK_CORP_ID=

# 数据与图标目录（相对项目根；Docker 中由 compose 覆盖为 /app/...）
# 图标目录需可写：后台上传会把 PNG 写入这里。
DATA_DIR=./data
ICONS_DIR=./assets/icons

# cookie Secure：auto（默认，按请求协议）/ true / false
COOKIE_SECURE=auto

# 反代后从 X-Forwarded-For 取客户端 IP 做限流；直连且不可信时设 0
TRUST_PROXY=1
