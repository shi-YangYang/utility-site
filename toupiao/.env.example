# 本地配置模板。
#
# 使用方式：
#   cp .env.example .env
# 然后按注释修改。.env 已被 git 忽略，绝不能提交。
#
# 本地开发最省事的做法：AUTH_MODE=mock，然后随便填一个至少 8 位的管理口令。
# 上线前务必改为 AUTH_MODE=dingtalk，并填入真实钉钉应用凭据。

# 运行
PORT=3001
NODE_ENV=development

# Docker 宿主映射端口（仅 docker compose 使用；默认 3001）
# HOST_PORT=3001

# 登录方式：dingtalk（线上）| mock（仅本地开发，前台会显示“开发模式”）
AUTH_MODE=dingtalk

# 后台管理口令，至少 8 位；不要使用本示例值
ADMIN_PASSWORD=change-me-now

# 会话签名密钥，至少 32 位随机串
# 生成示例：openssl rand -hex 32
SESSION_SECRET=replace-with-at-least-32-random-characters

# 站点对外地址；dingtalk 模式下必填，用来拼 /api/auth/callback
# 例：https://vote.example.com
PUBLIC_BASE_URL=

# 钉钉企业内部应用凭据（AUTH_MODE=dingtalk 时必填）
DINGTALK_APP_KEY=
DINGTALK_APP_SECRET=
# 可选：企业 corpId，填写后登录限定到该企业
DINGTALK_CORP_ID=

# 数据与图标目录（相对项目根；Docker 中由 compose 覆盖为 /app/...）
DATA_DIR=./data
ICONS_DIR=./assets/icons

# cookie Secure：auto（默认，按请求协议）/ true / false
COOKIE_SECURE=auto

# 反代后从 X-Forwarded-For 取客户端 IP 做限流；直连且不可信时设 0
TRUST_PROXY=1
